#!/usr/bin/env python3
"""
SwanLab 实时训练监控脚本 — Ingest GRPO

同时解析：
1. slime 训练日志 (train.log / run*.log) → entropy, kl_loss, pg_loss, grad_norm, lr
2. slime 验证日志 (train.log 中 eval step) → eval_loss, eval_reward, eval_kl
3. reward 细分日志 (reward_metrics.jsonl) → r_probe, r_format, r_total
4. rollout 详细记录 (rollout_records.jsonl) → 成功率、probe 命中率、response 长度分布
5. rollout perf 日志 → step_time, train_time, wait_time_ratio, tok/s
6. 系统指标 (GPU 利用率、显存使用)

用法:
    python scripts/swanlab_monitor.py --log-dir <日志目录> [--run-name <运行名称>]
"""

import argparse
import json
import os
import re
import subprocess
import time
import logging
import statistics
from pathlib import Path
from collections import deque

import swanlab

logging.basicConfig(level=logging.INFO, format="[%(asctime)s] %(message)s", datefmt="%H:%M:%S")
logger = logging.getLogger(__name__)

# SwanLab API Key
SWANLAB_API_KEY = os.environ.get("SWANLAB_API_KEY", "BVQaRTEEZKWC9p3iF5MMp")


def strip_ansi(text: str) -> str:
    """移除 ANSI 颜色码和 Ray 前缀"""
    text = re.sub(r'\x1b\[[0-9;]*m', '', text)
    text = re.sub(r'\([^)]*pid=\d+[^)]*\)\s*', '', text)
    return text


# ===========================================================================
# 训练日志解析器
# ===========================================================================

def parse_train_metric_line(line: str) -> dict | None:
    """解析训练指标行 (model.py 输出)

    格式: ... model.py ... step X: {...}
    """
    if "model.py" not in line or "step" not in line:
        return None
    line = strip_ansi(line)
    match = re.search(r"step\s+(\d+):\s*(\{.*\})", line)
    if not match:
        return None
    try:
        step = int(match.group(1))
        data = eval(match.group(2))
        data["_step"] = step
        return data
    except Exception:
        return None


def parse_eval_metric_line(line: str) -> dict | None:
    """解析验证指标行

    Slime 在 eval 阶段输出格式可能为:
    - "eval step X: {...}"
    - "validation step X: {...}"
    - "eval_step X: {...}"
    - 或 model.py 中带 "eval" 标记的行
    """
    line_stripped = strip_ansi(line)

    # 模式1: "eval step X: {…}" 或 "eval_step X: {…}"
    match = re.search(r"(?:eval|validation)[_\s]+(?:step\s*)?(\d+):\s*(\{.*\})", line_stripped, re.IGNORECASE)
    if match:
        try:
            step = int(match.group(1))
            data = eval(match.group(2))
            data["_eval_step"] = step
            return data
        except Exception:
            return None

    # 模式2: model.py 中包含 eval 关键字的 step 行
    if "eval" in line_stripped.lower() and "step" in line_stripped.lower():
        match = re.search(r"step\s+(\d+):\s*(\{.*\})", line_stripped)
        if match:
            try:
                step = int(match.group(1))
                data = eval(match.group(2))
                # 区分 eval: 存在 eval 关键字 或 loss 前缀带 eval
                if any("eval" in k.lower() for k in data.keys()) or "eval" in line_stripped.lower().split("step")[0]:
                    data["_eval_step"] = step
                    return data
            except Exception:
                return None

    # 模式3: "eval/reward" 或 "val/reward" 格式的行 (Slime 特定输出)
    match = re.search(r"(eval|val)\s+(\d+):\s*(\{.*\})", line_stripped, re.IGNORECASE)
    if match:
        try:
            step = int(match.group(2))
            data = eval(match.group(3))
            data["_eval_step"] = step
            return data
        except Exception:
            return None

    return None


def parse_rollout_perf_line(line: str) -> dict | None:
    """解析 perf 输出行 (train_metric_utils.py 输出)"""
    if "perf" not in line:
        return None
    if "train_metric_utils" not in line and "rollout.py" not in line:
        return None
    line = strip_ansi(line)
    match = re.search(r"perf\s+(\d+):\s*(\{.*\})", line)
    if not match:
        return None
    try:
        data = eval(match.group(2))
        data["_rollout_id"] = int(match.group(1))
        return data
    except Exception:
        return None


def parse_rollout_metric_line(line: str) -> dict | None:
    """解析 rollout 指标行 (data.py 输出)"""
    if "data.py" not in line or "rollout" not in line:
        return None
    line = strip_ansi(line)
    match = re.search(r"rollout\s+(\d+):\s*(\{.*\})", line)
    if not match:
        return None
    try:
        data = eval(match.group(2))
        data["_rollout_id"] = int(match.group(1))
        return data
    except Exception:
        return None


def parse_error_line(line: str) -> str | None:
    """解析错误行，用于统计 rollout 中的错误类型"""
    line_stripped = strip_ansi(line)
    if "ERROR" in line_stripped or "error" in line_stripped.lower():
        # 提取错误类型
        if "Too many open files" in line_stripped:
            return "too_many_open_files"
        elif "TimeoutError" in line_stripped or "timeout" in line_stripped.lower():
            return "timeout"
        elif "ConnectionError" in line_stripped or "connection" in line_stripped.lower():
            return "connection_error"
        elif "OOM" in line_stripped or "out of memory" in line_stripped.lower():
            return "oom"
        elif "CUDA" in line_stripped:
            return "cuda_error"
        elif "http" in line_stripped.lower() and ("4" in line_stripped or "5" in line_stripped):
            return "http_error"
        else:
            return "other_error"
    return None


# ===========================================================================
# GPU 系统指标采集
# ===========================================================================

def get_gpu_metrics() -> dict | None:
    """通过 nvidia-smi 获取 GPU 利用率和显存指标"""
    try:
        result = subprocess.run(
            ["nvidia-smi", "--query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=10,
        )
        if result.returncode != 0:
            return None

        gpu_utils = []
        mem_used_total = 0
        mem_total_total = 0
        temps = []

        for line in result.stdout.strip().split("\n"):
            parts = [p.strip() for p in line.split(",")]
            if len(parts) >= 4:
                try:
                    gpu_utils.append(float(parts[0]))
                    mem_used_total += float(parts[1])
                    mem_total_total += float(parts[2])
                    temps.append(float(parts[3]))
                except ValueError:
                    continue

        if not gpu_utils:
            return None

        return {
            "system/gpu_util_mean": statistics.mean(gpu_utils),
            "system/gpu_util_max": max(gpu_utils),
            "system/gpu_mem_used_gb": mem_used_total / 1024,
            "system/gpu_mem_total_gb": mem_total_total / 1024,
            "system/gpu_mem_util_pct": (mem_used_total / mem_total_total * 100) if mem_total_total > 0 else 0,
            "system/gpu_temp_mean": statistics.mean(temps),
            "system/gpu_temp_max": max(temps),
            "system/num_gpus": len(gpu_utils),
        }
    except (subprocess.TimeoutExpired, FileNotFoundError, Exception):
        return None


# ===========================================================================
# 核心监控循环
# ===========================================================================

def monitor(
    train_log: Path,
    reward_log: Path,
    rollout_records_log: Path,
    poll_interval: float = 5.0,
    gpu_poll_interval: float = 30.0,
):
    """实时监控日志并上传到 SwanLab"""
    logger.info(f"监控训练日志: {train_log}")
    logger.info(f"监控 reward 日志: {reward_log}")
    logger.info(f"监控 rollout 记录: {rollout_records_log}")

    # 文件读取位置
    train_pos = 0
    reward_pos = 0
    rollout_records_pos = 0

    # 全局计数器
    global_step = 0
    eval_step_count = 0
    reward_batch_count = 0
    rollout_group_rewards: list[float] = []
    rollout_group_count = 0

    # 错误统计（滑动窗口）
    error_window: deque = deque(maxlen=1000)
    error_counts: dict[str, int] = {}

    # Rollout 记录统计（滑动窗口，每 50 条汇总一次）
    rollout_record_buffer: list[dict] = []
    rollout_record_batch = 0

    # val 指标累积（每轮 eval 可能输出多行）
    eval_metrics_buffer: dict[str, list] = {}

    # GPU 指标采集时间
    last_gpu_poll = 0.0

    # 训练开始时间
    train_start_time = time.time()

    while True:
        now = time.time()

        # ============================================================
        # 1. 解析训练日志 (train + eval + perf + rollout + errors)
        # ============================================================
        if train_log.exists():
            with open(train_log, "r", errors="replace") as f:
                f.seek(train_pos)
                new_lines = f.readlines()
                train_pos = f.tell()

            for line in new_lines:
                line = line.strip()
                if not line:
                    continue

                # --- 训练指标 ---
                train_data = parse_train_metric_line(line)
                if train_data:
                    step = train_data.get("_step", global_step)
                    global_step = step
                    metrics = {}

                    key_mapping = {
                        "train/entropy_loss": "train/entropy",
                        "train/kl_loss": "train/kl_loss",
                        "train/pg_loss": "train/pg_loss",
                        "train/pg_clipfrac": "train/pg_clipfrac",
                        "train/ppo_kl": "train/ppo_kl",
                        "train/loss": "train/total_loss",
                        "train/grad_norm": "train/grad_norm",
                        "train/value_loss": "train/value_loss",
                        "train/approx_kl": "train/approx_kl",
                        "train/policy_kl": "train/policy_kl",
                        "train/clip_fraction": "train/clip_fraction",
                    }
                    for src, dst in key_mapping.items():
                        if src in train_data and isinstance(train_data[src], (int, float)):
                            metrics[dst] = train_data[src]

                    # 学习率
                    for key, val in train_data.items():
                        if "lr-pg" in key and isinstance(val, (int, float)):
                            metrics["train/lr"] = val
                            break
                        elif "lr" == key and isinstance(val, (int, float)):
                            metrics["train/lr"] = val

                    # 动态捕获所有 train/ 前缀的数值指标
                    for key, val in train_data.items():
                        if key.startswith("train/") and isinstance(val, (int, float)) and key not in key_mapping:
                            metrics[key] = val

                    # 训练进度指标
                    metrics["progress/global_step"] = step
                    metrics["progress/elapsed_minutes"] = (now - train_start_time) / 60.0

                    if metrics:
                        swanlab.log(metrics, step=step)
                    continue

                # --- 验证 (eval) 指标 ---
                eval_data = parse_eval_metric_line(line)
                if eval_data:
                    eval_step_count += 1
                    step = eval_data.get("_eval_step", eval_step_count)
                    metrics = {}

                    # 常见 eval 指标映射
                    eval_key_mapping = {
                        "eval/loss": "val/loss",
                        "eval/entropy_loss": "val/entropy",
                        "eval/kl_loss": "val/kl_loss",
                        "eval/pg_loss": "val/pg_loss",
                        "eval/reward": "val/reward",
                        "eval/reward_mean": "val/reward_mean",
                        "eval/reward_std": "val/reward_std",
                        "eval/response_length": "val/response_length",
                        "eval/advantages": "val/advantages",
                        "eval/log_probs": "val/log_probs",
                        "eval/ref_log_probs": "val/ref_log_probs",
                        "eval/rewards": "val/rewards",
                        "eval/raw_reward": "val/raw_reward",
                        # 兼容不带 eval/ 前缀
                        "loss": "val/loss",
                        "reward": "val/reward",
                        "rewards": "val/rewards",
                        "raw_reward": "val/raw_reward",
                        "response_lengths": "val/response_length",
                    }
                    for src, dst in eval_key_mapping.items():
                        if src in eval_data and isinstance(eval_data[src], (int, float)):
                            metrics[dst] = eval_data[src]

                    # 动态捕获所有 eval/ 前缀的数值指标
                    for key, val in eval_data.items():
                        if key.startswith(("eval/", "val/")) and isinstance(val, (int, float)):
                            dst = key.replace("eval/", "val/")
                            if dst not in metrics:
                                metrics[dst] = val

                    if metrics:
                        swanlab.log(metrics, step=global_step or step)
                        logger.info(f"[Val] step={step}, metrics={list(metrics.keys())}")
                    continue

                # --- Rollout 指标 ---
                rollout_data = parse_rollout_metric_line(line)
                if rollout_data:
                    rid = rollout_data.get("_rollout_id", 0)
                    metrics = {}
                    for key in ("rollout/rewards", "rollout/raw_reward", "rollout/response_lengths",
                                "rollout/advantages", "rollout/log_probs", "rollout/ref_log_probs",
                                "rollout/kl", "rollout/entropy", "rollout/reward_mean",
                                "rollout/reward_std", "rollout/num_samples"):
                        if key in rollout_data and isinstance(rollout_data[key], (int, float)):
                            metrics[key] = rollout_data[key]
                    if metrics:
                        swanlab.log(metrics, step=rid)
                    continue

                # --- Perf 指标 ---
                perf_data = parse_rollout_perf_line(line)
                if perf_data:
                    rid = perf_data.get("_rollout_id", 0)
                    metrics = {}
                    perf_keys = {
                        "perf/step_time": "perf/step_time",
                        "perf/update_weights_time": "perf/update_weights_time",
                        "perf/train_time": "perf/train_time",
                        "perf/train_wait_time": "perf/train_wait_time",
                        "perf/actor_train_time": "perf/actor_train_time",
                        "perf/actor_train_tok_per_s": "perf/actor_train_tok_per_s",
                        "perf/wait_time_ratio": "perf/wait_time_ratio",
                        "perf/actor_train_tflops": "perf/actor_train_tflops",
                        "perf/rollout_time": "perf/rollout_time",
                        "perf/reward_time": "perf/reward_time",
                        "perf/generate_time": "perf/generate_time",
                        "perf/samples_per_sec": "perf/samples_per_sec",
                    }
                    for src, dst in perf_keys.items():
                        if src in perf_data and isinstance(perf_data[src], (int, float)):
                            metrics[dst] = perf_data[src]

                    # 动态捕获其他 perf/ 指标
                    for key, val in perf_data.items():
                        if key.startswith("perf/") and isinstance(val, (int, float)) and key not in perf_keys:
                            metrics[key] = val

                    if metrics:
                        swanlab.log(metrics, step=rid)
                    continue

                # --- 错误统计 ---
                error_type = parse_error_line(line)
                if error_type:
                    error_window.append((now, error_type))
                    error_counts[error_type] = error_counts.get(error_type, 0) + 1

        # ============================================================
        # 2. 解析 reward 细分指标日志
        # ============================================================
        if reward_log.exists():
            with open(reward_log, "r", errors="replace") as f:
                f.seek(reward_pos)
                new_lines = f.readlines()
                reward_pos = f.tell()

            for line in new_lines:
                line = line.strip()
                if not line:
                    continue
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue

                reward_batch_count += 1
                # 动态读取 reward_metrics.jsonl 中所有数值字段
                metrics = {}
                for key, val in record.items():
                    if isinstance(val, (int, float)):
                        metrics[f"reward/{key}"] = val
                if metrics:
                    swanlab.log(metrics, step=reward_batch_count)

                # 每 N_SAMPLES_PER_PROMPT 个 sample 一组，计算组内 reward std 和 advantage
                n_samples = int(os.environ.get("N_SAMPLES_PER_PROMPT", "8"))
                r_total = record.get("r_total", record.get("reward", 0))
                rollout_group_rewards.append(float(r_total))
                if len(rollout_group_rewards) >= n_samples:
                    rollout_group_count += 1
                    group_mean = statistics.mean(rollout_group_rewards)
                    group_std = statistics.pstdev(rollout_group_rewards)
                    if group_std > 0:
                        advantages = [(r - group_mean) / (group_std + 1e-6) for r in rollout_group_rewards]
                    else:
                        advantages = [0.0] * len(rollout_group_rewards)
                    swanlab.log({
                        "reward_group/mean": group_mean,
                        "reward_group/std": group_std,
                        "reward_group/max": max(rollout_group_rewards),
                        "reward_group/min": min(rollout_group_rewards),
                        "reward_group/advantage_max": max(advantages),
                        "reward_group/advantage_min": min(advantages),
                        "reward_group/advantage_spread": max(advantages) - min(advantages),
                    }, step=rollout_group_count)
                    rollout_group_rewards = []

                if reward_batch_count % 50 == 0:
                    logger.info(
                        f"[Reward] batch={reward_batch_count}, "
                        f"r_total={record.get('r_total', 0):.3f}"
                    )

        # ============================================================
        # 3. 解析 rollout 详细记录（成功率、probe 命中等）
        # ============================================================
        if rollout_records_log.exists():
            with open(rollout_records_log, "r", errors="replace") as f:
                f.seek(rollout_records_pos)
                new_lines = f.readlines()
                rollout_records_pos = f.tell()

            for line in new_lines:
                line = line.strip()
                if not line:
                    continue
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue

                rollout_record_buffer.append(record)

                # 每 50 条汇总一次
                if len(rollout_record_buffer) >= 50:
                    rollout_record_batch += 1
                    _log_rollout_record_stats(rollout_record_buffer, rollout_record_batch)
                    rollout_record_buffer = []

        # ============================================================
        # 4. 定期采集 GPU 系统指标
        # ============================================================
        if now - last_gpu_poll >= gpu_poll_interval:
            last_gpu_poll = now
            gpu_metrics = get_gpu_metrics()
            if gpu_metrics:
                swanlab.log(gpu_metrics, step=global_step or reward_batch_count or 1)

        # ============================================================
        # 5. 定期上报错误率统计
        # ============================================================
        if error_counts and global_step > 0:
            # 计算最近 5 分钟的错误率
            cutoff = now - 300
            recent_errors = [e for e in error_window if e[0] >= cutoff]
            if recent_errors:
                error_metrics = {
                    "errors/total_5min": len(recent_errors),
                }
                type_counts: dict[str, int] = {}
                for _, etype in recent_errors:
                    type_counts[etype] = type_counts.get(etype, 0) + 1
                for etype, count in type_counts.items():
                    error_metrics[f"errors/{etype}_5min"] = count
                swanlab.log(error_metrics, step=global_step)

        time.sleep(poll_interval)


def _log_rollout_record_stats(records: list[dict], batch_id: int) -> None:
    """汇总一批 rollout 详细记录并上报"""
    rewards = []
    probe_scores = []
    format_scores = []
    response_lens = []
    error_count = 0

    for rec in records:
        reward = rec.get("reward", 0)
        rewards.append(float(reward))

        sub = rec.get("sub_rewards", {})
        if isinstance(sub, dict):
            if "r_probe" in sub:
                probe_scores.append(float(sub["r_probe"]))
            if "r_format" in sub:
                format_scores.append(float(sub["r_format"]))
            if "error" in sub:
                error_count += 1

        resp_len = rec.get("response_len", 0)
        if isinstance(resp_len, (int, float)):
            response_lens.append(int(resp_len))

    metrics: dict[str, float] = {}

    if rewards:
        metrics["rollout_stats/reward_mean"] = statistics.mean(rewards)
        metrics["rollout_stats/reward_std"] = statistics.pstdev(rewards) if len(rewards) > 1 else 0
        metrics["rollout_stats/reward_max"] = max(rewards)
        metrics["rollout_stats/reward_min"] = min(rewards)
        metrics["rollout_stats/reward_median"] = statistics.median(rewards)
        # 成功率：reward > 0 的比例
        metrics["rollout_stats/success_rate"] = sum(1 for r in rewards if r > 0) / len(rewards)
        # 完美率：reward >= 0.9 的比例
        metrics["rollout_stats/perfect_rate"] = sum(1 for r in rewards if r >= 0.9) / len(rewards)
        # 零分率
        metrics["rollout_stats/zero_rate"] = sum(1 for r in rewards if r <= 0) / len(rewards)

    if probe_scores:
        metrics["rollout_stats/probe_mean"] = statistics.mean(probe_scores)
        metrics["rollout_stats/probe_hit_rate"] = sum(1 for p in probe_scores if p > 0) / len(probe_scores)
        metrics["rollout_stats/probe_perfect_rate"] = sum(1 for p in probe_scores if p >= 1.0) / len(probe_scores)

    if format_scores:
        metrics["rollout_stats/format_mean"] = statistics.mean(format_scores)
        metrics["rollout_stats/format_pass_rate"] = sum(1 for f in format_scores if f >= 1.0) / len(format_scores)

    if response_lens:
        metrics["rollout_stats/response_len_mean"] = statistics.mean(response_lens)
        metrics["rollout_stats/response_len_max"] = max(response_lens)
        metrics["rollout_stats/response_len_min"] = min(response_lens)
        metrics["rollout_stats/response_len_p50"] = statistics.median(response_lens)

    metrics["rollout_stats/error_rate"] = error_count / len(records) if records else 0
    metrics["rollout_stats/batch_size"] = len(records)

    if metrics:
        swanlab.log(metrics, step=batch_id)
        logger.info(
            f"[RolloutStats] batch={batch_id}, reward_mean={metrics.get('rollout_stats/reward_mean', 0):.3f}, "
            f"success_rate={metrics.get('rollout_stats/success_rate', 0):.2%}, "
            f"probe_mean={metrics.get('rollout_stats/probe_mean', 0):.3f}"
        )


# ===========================================================================
# 入口
# ===========================================================================

def main():
    import datetime

    parser = argparse.ArgumentParser(description="SwanLab 实时训练监控 — Ingest GRPO")
    parser.add_argument("--log-dir", type=str, required=True, help="训练日志目录")
    parser.add_argument("--run-name", type=str, default=None, help="SwanLab 运行名称")
    parser.add_argument("--task-version", type=str, default=None, help="task version (如 atomic_code_t2, agent_loop)")
    parser.add_argument("--poll-interval", type=float, default=5.0, help="轮询间隔(秒)")
    parser.add_argument("--gpu-poll-interval", type=float, default=30.0, help="GPU 指标采集间隔(秒)")
    args = parser.parse_args()

    log_dir = Path(args.log_dir)
    train_log = log_dir / "train.log"
    if not train_log.exists():
        # 尝试在 parent 中找最新的 run*.log
        output_dir = log_dir.parent
        run_logs = sorted(output_dir.parent.glob("run*.log"), key=lambda p: p.stat().st_mtime, reverse=True)
        if run_logs:
            train_log = run_logs[0]

    reward_log = log_dir / "reward_metrics.jsonl"
    rollout_records_log = log_dir / "rollout_records.jsonl"

    # experiment_name 格式: {task_version}_ingest_{时间戳}
    task_version = args.task_version or os.environ.get("MEMORY_RL_TASK_VERSION", "atomic_code_t2")
    timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    run_name = args.run_name or f"{task_version}_ingest_{timestamp}"

    os.environ["SWANLAB_API_KEY"] = SWANLAB_API_KEY
    swanlab.init(
        project="memory_ai_rl",
        experiment_name=run_name,
        mode="cloud",
        config={
            "model": "Qwen3.5-35B-A3B",
            "task": "ingest",
            "task_version": task_version,
            "log_dir": str(log_dir),
            "train_log": str(train_log),
            "reward_log": str(reward_log),
            "rollout_records_log": str(rollout_records_log),
            "poll_interval": args.poll_interval,
            "gpu_poll_interval": args.gpu_poll_interval,
            "reward_weights": {"r_probe": 0.9, "r_format": 0.1},
            "n_samples_per_prompt": int(os.environ.get("N_SAMPLES_PER_PROMPT", "8")),
            "monitored_metrics": [
                "train/*", "val/*", "rollout/*", "perf/*",
                "reward/*", "reward_group/*", "rollout_stats/*",
                "system/*", "errors/*", "progress/*",
            ],
        },
    )
    logger.info(f"SwanLab 初始化: project=memory_ai_rl, run={run_name}")
    logger.info(f"SwanLab URL: {swanlab.get_url()}")
    logger.info(f"监控指标组: train, val, rollout, perf, reward, reward_group, rollout_stats, system, errors, progress")

    try:
        monitor(
            train_log,
            reward_log,
            rollout_records_log,
            poll_interval=args.poll_interval,
            gpu_poll_interval=args.gpu_poll_interval,
        )
    except KeyboardInterrupt:
        logger.info("监控终止")
    finally:
        swanlab.finish()
        logger.info("SwanLab 已关闭")


if __name__ == "__main__":
    main()
