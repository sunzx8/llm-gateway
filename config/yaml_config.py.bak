"""YAML 配置文件读取模块。

从 config/config.yaml 中读取 Memory LLM、Embedding、Storage 等配置，
并提供便捷的获取方法。

配置文件路径优先级：
    1. 环境变量 LLM_GATEWAY_CONFIG 指定的路径
    2. 项目根目录下的 config/config.yaml
"""

from __future__ import annotations

import logging
import os
from pathlib import Path
from typing import Any

import yaml

logger = logging.getLogger(__name__)

# 默认配置文件路径（与本模块同目录下的 config.yaml）
_DEFAULT_CONFIG_PATH = Path(__file__).parent / "config.yaml"

# 模块级缓存
_yaml_cache: dict[str, Any] | None = None


class YamlConfig:
    """YAML 配置文件读取类。

    支持从 config.yaml 中读取各模块的配置，提供字典式访问和类型安全的配置获取。

    使用方式：
        cfg = YamlConfig()
        # 获取完整的 memory_llm 配置段
        llm_section = cfg.get_section("memory_llm")
        # 获取单个值
        model = cfg.get("memory_llm.model", default="gpt-4o")
    """

    def __init__(self, config_path: str | Path | None = None):
        """初始化配置读取器。

        Args:
            config_path: 配置文件路径。None 则按优先级自动查找。
        """
        if config_path:
            self._path = Path(config_path)
        else:
            env_path = os.environ.get("LLM_GATEWAY_CONFIG")
            self._path = Path(env_path) if env_path else _DEFAULT_CONFIG_PATH

        self._data: dict[str, Any] = {}
        self._load()

    def _load(self) -> None:
        """加载 YAML 配置文件。"""
        if not self._path.exists():
            logger.warning("配置文件不存在: %s，将使用默认值", self._path)
            return

        try:
            with open(self._path, "r", encoding="utf-8") as f:
                data = yaml.safe_load(f)
            if isinstance(data, dict):
                self._data = data
                logger.debug("已加载 YAML 配置文件: %s", self._path)
            else:
                logger.warning("配置文件格式异常（非字典）: %s", self._path)
        except (yaml.YAMLError, OSError) as e:
            logger.warning("加载配置文件失败: %s，错误: %s", self._path, e)

    def get_section(self, section: str) -> dict[str, Any]:
        """获取指定配置段的完整字典。

        Args:
            section: 顶层配置段名称，如 "memory_llm"、"embedding"。

        Returns:
            该配置段的字典；若不存在则返回空字典。
        """
        return self._data.get(section, {})

    def get(self, key_path: str, *, default: Any = None) -> Any:
        """通过点分路径获取配置值。

        Args:
            key_path: 点分隔的配置路径，如 "memory_llm.model"。
            default: 配置项不存在时的默认值。

        Returns:
            配置值，若不存在则返回 default。
        """
        keys = key_path.split(".")
        current: Any = self._data
        for k in keys:
            if isinstance(current, dict):
                current = current.get(k)
            else:
                return default
            if current is None:
                return default
        return current

    @property
    def raw(self) -> dict[str, Any]:
        """返回原始配置字典（只读引用）。"""
        return self._data

    def reload(self) -> None:
        """强制重新加载配置文件。"""
        self._data = {}
        self._load()


# ---------------------------------------------------------------------------
# 模块级便捷方法（单例模式）
# ---------------------------------------------------------------------------

_instance: YamlConfig | None = None


def _get_instance() -> YamlConfig:
    """获取全局单例 YamlConfig 实例。"""
    global _instance
    if _instance is None:
        _instance = YamlConfig()
    return _instance


def get_memory_llm_config() -> dict[str, Any]:
    """从 YAML 配置文件获取 Memory LLM 配置，返回配置字典。

    配置段示例（config.yaml）：
        memory_llm:
          provider: openai_compat
          model: glm-5.1
          base_url: http://124.221.221.186:30000/v1
          api_key: none
          temperature: 1.0
          max_tokens: 4096
          timeout: 600.0
          max_retries: 3

    Returns:
        配置字典。若配置文件中无 memory_llm 段，返回空字典。
    """
    cfg = _get_instance()
    section = cfg.get_section("memory_llm")

    if not section:
        logger.debug("YAML 中未找到 memory_llm 配置段，将使用默认值")

    return section


def get_embedding_config() -> dict[str, Any]:
    """从 YAML 配置文件获取 Embedding 配置，返回配置字典。

    配置段示例（config.yaml）：
        embedding:
          provider: openai_compat
          model: bge-m3
          base_url: http://localhost:8080/v1
          api_key: none
          batch_size: 64
          dimensions: null
          timeout: 120.0
          max_retries: 3

    Returns:
        配置字典。若配置文件中无 embedding 段，返回空字典。
    """
    cfg = _get_instance()
    section = cfg.get_section("embedding")

    if not section:
        logger.debug("YAML 中未找到 embedding 配置段，将使用默认值")

    return section


def get_storage_config() -> dict[str, Any]:
    """从 YAML 配置文件获取 Storage 配置，返回配置字典。

    配置段示例（config.yaml）：
        storage:
          backend: memory        # memory / pg
          pg:
            dsn: null
            host: "127.0.0.1"
            port: 5544
            user: "t2"
            password: "t2"
            database: "t2"
            pool_min_size: 2
            pool_max_size: 16

    Returns:
        配置字典。若配置文件中无 storage 段，返回空字典。
    """
    cfg = _get_instance()
    section = cfg.get_section("storage")

    if not section:
        logger.debug("YAML 中未找到 storage 配置段，将使用默认值")

    return section


def get_storage_backend() -> str:
    """获取存储后端类型。

    优先级：
        1. YAML 配置文件中的 storage.backend
        2. 环境变量 MEMORY_STORAGE_BACKEND
        3. 默认值 "memory"

    Returns:
        后端类型字符串（"memory" 或 "pg"）。
    """
    cfg = _get_instance()
    backend = cfg.get("storage.backend")
    if backend:
        return str(backend).lower().strip()
    return os.environ.get("MEMORY_STORAGE_BACKEND", "memory").lower().strip()


def get_pg_config() -> dict[str, Any]:
    """从 YAML 配置文件获取 PostgreSQL 连接配置，返回配置字典。

    配置段示例（config.yaml）：
        storage:
          pg:
            dsn: null
            host: "127.0.0.1"
            port: 5544
            user: "t2"
            password: "t2"
            database: "t2"
            pool_min_size: 2
            pool_max_size: 16

    优先级：
        YAML 配置 > 环境变量 > 默认值

    Returns:
        PG 配置字典，包含 dsn/host/port/user/password/database/pool_min_size/pool_max_size。
    """
    cfg = _get_instance()
    section = cfg.get("storage.pg") or {}

    # 合并环境变量回退
    return {
        "dsn": section.get("dsn") or os.environ.get("PG_DSN"),
        "host": section.get("host") or os.environ.get("PG_HOST", "127.0.0.1"),
        "port": int(section.get("port") or os.environ.get("PG_PORT", "5544")),
        "user": section.get("user") or os.environ.get("PG_USER", "t2"),
        "password": section.get("password") or os.environ.get("PG_PASSWORD", "t2"),
        "database": section.get("database") or os.environ.get("PG_DB", "t2"),
        "pool_min_size": int(section.get("pool_min_size", 2)),
        "pool_max_size": int(section.get("pool_max_size", 16)),
    }


def get_context_task_config(task_name: str) -> dict[str, Any]:
    """获取指定 Context Task 的完整配置字典。

    配置段示例（config.yaml）：
        context_task:
          ingest_context_task:
            token_budget_per_ingest: 2000
            max_messages_per_ingest: 10
            max_turns: 15
          consolidate_context_task:
            min_items_for_evolution: 5
            max_turns: 20
          retrieve_context_task:
            max_turns: 20

    Args:
        task_name: 任务配置键名，如 "ingest_context_task"。

    Returns:
        该任务的配置字典；若不存在则返回空字典。
    """
    cfg = _get_instance()
    section = cfg.get_section("context_task")
    return section.get(task_name, {})


def get_context_task_config_value(
    task_name: str,
    key: str,
    *,
    default: Any = None,
) -> Any:
    """获取指定 Context Task 的单个配置值。

    Args:
        task_name: 任务配置键名，如 "ingest_context_task"。
        key: 配置项键名，如 "max_turns"。
        default: 配置项不存在时的默认值。

    Returns:
        配置值，若不存在则返回 default。
    """
    task_cfg = get_context_task_config(task_name)
    return task_cfg.get(key, default)


def reload_yaml_config() -> None:
    """强制重新加载 YAML 配置（清除缓存）。"""
    global _instance
    if _instance:
        _instance.reload()
    else:
        _instance = YamlConfig()
